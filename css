/* --- CONFIGURAÇÕES GERAIS E VARIÁVEIS --- */
:root {
    --primary: #2d5a27;
    --secondary: #a8dadc;
    --accent: #e63946;
    --bg-light: #f1faee;
    --text-dark: #1d3557;
    --white: #ffffff;
    --radius: 8px;
    --transition: all 0.3s ease;
    --font-base: 16px;
}

/* --- MODO ALTO CONTRASTE --- */
body.high-contrast {
    --primary: #ffff00;
    --bg-light: #000000;
    --text-dark: #ffffff;
    --white: #000000;
    --accent: #ffff00;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { font-size: var(--font-base); scroll-behavior: smooth; }

body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background-color: var(--bg-light);
    color: var(--text-dark);
    line-height: 1.6;
}

.container { padding: 4rem 10%; }

/* --- GRID E LAYOUT (Mobile First) --- */
.grid-container {
    display: grid;
    grid-template-columns: 1fr; /* 1 coluna mobile */
    gap: 2rem;
    margin-top: 2rem;
}

